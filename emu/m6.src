HEADIF:IF;all
TEXT

The @code{IF} will call a macro in the @code{0} macro set
to redo the arguments with the @code{m6if} pattern.
This pattern will do the to do the comparisons 
and set the correct answer.

END
CODE
0_pattern:m6if;[@00-@ff]~;stack_a begin-1  
0_pattern:m6if;[,:];+-+stack_a end begin 
stack_b argnum 2 mod =0 if
argnum 1 - getarg =1 if 
argnum getarg 
endif endif-+-   
0_pattern:m6if;[:]; stop
0_def_mcall:IF;6_IF;0;nn00;m6;;m6def
0_define:6_IF;0_IF$@:;;rn00;m6;;;0
0_define:0_IF;$b0;;nr00;m6if;;;0
END
