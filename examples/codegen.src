TEXT

Setting some defaults.

END
CODE
0_chars_pattern:[]-\@+*?~
0_chars_args:1$*@#$;101;102;103
0_chars_args:1$*@#$;101;102;103;src
0_set_var:101;`
0_set_var:102;'
0_set_var:103;, 
END
TEXT

Special char for the space before and after an identifier.

END
CODE
0_specialchar: ;[@00-@2f@3a-@40@5b-@5e@60@7b-@ff]
END
TEXT

A pattern to collect the arguments of a function

END
CODE
0_specialchar:(;[@00-@27@29-@ff]
0_pattern:function;[\(]~;stack_b argpos =0 ifthen abort 
0_pattern:function;[@00-@ff]~;stack_c 0
0_pattern:function;(;stack_c 1 +
0_pattern:function;[(,][@00- ]*[!-@ff];stack_a begin-1 ;1
0_pattern:function;);stack_c 1 - dup =0 if stack_a end stop endif
0_pattern:function;,;stack_c dup <=1 if stack_a end endif
END
TEXT

A macro for a function

END
CODE
0_define:\ [a-zA-Z_][a-zA-Z_0-9]*[ ]*(;00_Function($0, $*);;nr11;function;;;src
END
TEXT

A macro for an identifier

END
CODE
0_define:\ [a-zA-Z_][a-zA-Z_0-9]*\ ;00_Identifier($0);;nn11;;;;src
END
TEXT

A macro for a constant

END
CODE
0_define:\ [0-9]+\ ;00_Constant($0);;nn11;;;;src
END
TEXT

Macro and pattern for a block

END
CODE
0_pattern:block;[@00-@ff]~;stack_b 1 stack_a begin-1
0_pattern:block;{;stack_b 1 +
0_pattern:block;};stack_b 1 - dup =0 if stack_a end stop endif
0_define:{;00_Block($1);;nr00 ;block;;;src
END
TEXT

Macros for keywords

END
CODE
0_define:\ int\ ;00_Keyword($0);;nn11;;;;src
0_define:\ void\ ;00_Keyword($0);;nn11;;;;src
0_define:\ return\ ;00_Keyword($0);;nn11;;;;src
END
TEXT

Switch to macroset to work through source

END
CODE
0_mset:src
END
