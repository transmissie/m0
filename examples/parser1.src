0_define:\ 0[1-7][0-7]*\ ;` 01_Constant_oct_$4:';substr;rn11;;;stack_a dup 1 ;src
0_define:\ 0[xX][0-9a-fA-F]+\ ;` 01_Constant_hex_$4:';substr;rn11;;;stack_a dup 2 ;src
0_define:\ 0[bB][01]+\ ;` 01_Constant_bin_$4:';substr;rn11;;;stack_a dup 2 ;src
END
