TEXT

Macros and programs for types

Using counters:

@table @asis
@item 10:
int
@item 11:
char
@item 12:
float
@item 13:
double
@item 14:
void

@item 15:
short
@item 16:
long
@item 17:
unsigned
@item 18:
signed


@end table

END
CODE
0_program:clrtypes;` 10 cnt_clr 11 cnt_clr 12 cnt_clr 13
cnt_clr 14 cnt_clr 15 cnt_clr 16 cnt_clr 17 cnt_clr 18 cnt_clr'
0_program:gettypes;` 17 cnt_get "unsigned " str*  
18 cnt_get "signed " str* cat
16 cnt_get "long " str* cat
15 cnt_get "short " str* cat
10 cnt_get 11 cnt_get + 12 cnt_get + 13 cnt_get + 14 cnt_get +
if
10 cnt_get "int" str* cat 
11 cnt_get "char"  str* cat
12 cnt_get "float" str* cat
13 cnt_get "double" str* cat
14 cnt_get "void" str* cat
else 
"int" cat 
endif'
0_define:\ short\ ;`01_Extend_short($0) ';;nn11 ;;; 15 cnt++;src
0_define:\ long\ ;`01_Extend_long($0) ';;nn11 ;;; 16 cnt++;src
0_define:\ unsigned\ ;`01_Extend_unsigned($0) ';;nn11 ;;; 17 cnt++;src
0_define:\ signed\ ;`01_Extend_signed($0) ';;nn11 ;;; 18 cnt++;src
0_define:\ int\ ;`01_Type_int($0) ';;nn11 ;;; 10 cnt++;src
0_define:\ void\ ;`01_Type_void($0) ';;nn11 ;;; 14 cnt++;src
0_define:\ float\ ;`01_Type_float($0) ';;nn11 ;;; 12 cnt++;src
0_define:\ double\ ;`01_Type_double($0) ';;nn11 ;;; 13 cnt++;src
0_define:\ char\ ;`01_Type_char($0) ';;nn11 ;;; 11 cnt++;src
END
TEXT

A pattern to collect the arguments of a function

Stack d is used to set the type of the function

END
CODE
0_specialchar:(;[@00-@27@29-@ff]
0_pattern:function;[\(]~;stack_b argpos =0 ifthen abort 
0_pattern:function;[@00-@ff]~;stack_c 0 stack_d @gettypes @clrtypes
0_pattern:function;(;stack_c 1 +
0_pattern:function;[(,][@00- ]*[!-@ff];stack_a begin-1 ;1
0_pattern:function;);stack_c 1 - dup =0 if stack_a end stop endif
0_pattern:function;,;stack_c dup <=1 if stack_a end endif
END
