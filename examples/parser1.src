END
CODE
0_pattern:declfunc;[@00-@ff]~;stack_c 0 stack_d @gettypes @clrtypes
0_pattern:declfunc;(;stack_c 1 +
0_pattern:declfunc;[(,][@00- ]*[!-@ff];stack_a begin-1 ;1
0_pattern:declfunc;);stack_c 1 - dup =0 if stack_a end stack_b begin endif
0_pattern:declfunc;,;stack_c dup =1 if stack_a end endif
0_pattern:declfunc;@3b; stack_b end stop
0_def_mcall:\ [a-zA-Z_][a-zA-Z_0-9]*(;1_declare_func:;0;nr11;declfunc;;src
0_define:1_declare_func:;`01_Decl_Fun($d0,$0,$b0,$*)
0_define:\ $0(; 01_CallFunction($0,$`'@);;nr11;args;;;src
0_define:\ $0\ ; 01_AddressFunction($0);;nn11;;;;src
';;rn01;0;;@clrtypes;0
END
