TEXT

string in macro set @code{0} and macro set @code{src}.

END
CODE
0_pattern:0string;[@00-@ff]~;stack_b 1 stack_a begin-1
0_pattern:0string;`;stack_b 1 +
0_pattern:0string;';stack_b 1 - dup =0 if stack_a end stop endif
0_define:`;$1;;nn00;0string;;;src
0_define:`;$1;;nn00;0string
END
TEXT

A pattern to collect the arguments of non functions

END
CODE
0_pattern:args;[\(]~;stack_b argpos =0 ifthen abort 
0_pattern:args;[@00-@ff]~;stack_c 0 
0_pattern:args;(;stack_c 1 +
0_pattern:args;[(,][@00- ]*[!-@ff];stack_a begin-1 ;1
0_pattern:args;);stack_c 1 - dup =0 if stack_a end stop endif
0_pattern:args;,;stack_c dup <=1 if stack_a end endif
END
